{
  "captured_at": "2026-07-28T18:19:10.797431+00:00",
  "purpose": "First per-day attestation measurement taken AFTER real backfilled partitions landed (2026-07-06..2026-07-11 via job -s3). Re-derives README section 6's 44-day cap against ingested data instead of projecting it, and confirms Defect D is the only PERMANENT attestation hole on the acceptance surface.",
  "method": {
    "predicate": "Mirrors forecast_training_view: source_run_complete = bool_and(ingestion.status='SUCCEEDED' AND finished_at IS NOT NULL) over canonical_lineage rows for canonical_table='core.transactions'. Evaluated on the SOURCE database because the PG16 target has not been re-activated since -s3 landed.",
    "inflight_rule": "A blocking run is in_flight (expected to settle on its own) when its partition has no SUCCEEDED run yet, and permanent otherwise -- the same rule as unattested_lineage_sweep.json.",
    "caveat": "Spans are whole-day: a date counts as attested only if EVERY qualifying transaction on it is attested, which is what the view's bool_and enforces. 2026-07-12..2026-07-22 are absent because jobs -s4/-s5 had not run at capture time.",
    "days_sql": "WITH txn AS ( SELECT t.transaction_id, t.store_id, (t.event_time AT TIME ZONE 'UTC')::date AS d FROM core.transactions t JOIN core.stores s ON s.store_id = t.store_id WHERE t.transaction_status='succeeded' AND t.currency='TWD' ), per_txn AS ( SELECT txn.d, txn.store_id, txn.transaction_id, count(l.*) AS lineage_rows, bool_and(r.status='SUCCEEDED' AND r.finished_at IS NOT NULL) AS attested FROM txn LEFT JOIN data_plane.canonical_lineage l ON l.canonical_table='core.transactions' AND l.canonical_id=txn.transaction_id LEFT JOIN data_plane.ingestion_runs r ON r.run_id=l.run_id GROUP BY 1,2,3 ) SELECT d, count(DISTINCT store_id), count(*), bool_and(lineage_rows>0), bool_and(coalesce(attested,false)), count(*) FILTER (WHERE NOT coalesce(attested,false)) FROM per_txn GROUP BY d ORDER BY d;",
    "blocking_runs_sql": "SELECT (t.event_time AT TIME ZONE 'UTC')::date AS d, r.run_id::text, count(*) FROM data_plane.canonical_lineage l JOIN data_plane.ingestion_runs r ON r.run_id=l.run_id JOIN core.transactions t ON t.transaction_id=l.canonical_id WHERE l.canonical_table='core.transactions' AND (r.status<>'SUCCEEDED' OR r.finished_at IS NULL) GROUP BY 1,2 ORDER BY 1;",
    "inflight_sql": "SELECT r.run_id::text FROM data_plane.ingestion_runs r WHERE (r.status<>'SUCCEEDED' OR r.finished_at IS NULL) AND NOT EXISTS (SELECT 1 FROM data_plane.ingestion_runs s WHERE s.source_kind=r.source_kind AND s.partition_key=r.partition_key AND s.status='SUCCEEDED')"
  },
