        "import json, os, glob, heapq\nfrom collections import defaultdict, deque\nstatus_root = os.environ.get(\"PANTHEON_STATUS_ROOT\", \"/home/lupin/odayplus\")\nboard = json.load(open(os.path.join(status_root, \"ai-status.json\")))\ntasks = {t[\"id\"]: {\"status\": t.get(\"status\"), \"depends_on\": t.get(\"depends_on\", []) or []} for t in board.get(\"tasks\", []) if \"id\" in t}\nfor p in glob.glob(os.path.join(status_root, \"ai-task-archive\", \"tasks\", \"*.json\")):\n    tid = os.path.splitext(os.path.basename(p))[0]\n    if tid not in tasks:\n        a = json.load(open(p))\n        tasks[tid] = {\"status\": a.get(\"status\", a.get(\"terminal_status\")), \"depends_on\": a.get(\"depends_on\", a.get(\"task_depends_on\", [])) or []}\n\nseed = [\"ODP-SITE001-MISSING-COMPONENTS-DISPOSITION-001\", \"ODP-STRUCTURAL-REMEDIATION-CLOSEOUT-001\", \"ODP-BRAND-TRANSFER-CONTRACT-PREP-001\", \"ODP-BRAND-TRANSFER-IMPLEMENTATION-001\", \"ODP-FORMAT-CONVERSION-CONTRACT-PREP-001\", \"ODP-FORMAT-CONVERSION-IMPLEMENTATION-001\", \"ODP-HUMAN-DECISIONS-EXECUTION-PLAN-001\"]\nvisited, queue, unresolved = set(), deque(seed), set()\nwhile queue:\n    curr = queue.popleft()\n    if curr in visited:\n        continue\n    visited.add(curr)\n    if curr in tasks:\n        for dep in tasks[curr][\"depends_on\"]:\n            if dep not in tasks:\n                unresolved.add(dep)\n            if dep not in visited:\n                queue.append(dep)\n\nin_degree = {v: 0 for v in visited}\nadj = defaultdict(list)\nedges = []\nfor u in sorted(visited):\n    for v in sorted(tasks.get(u, {}).get(\"depends_on\", [])):\n        if v in visited:\n            edges.append((u, v))\n            adj[v].append(u)\n            in_degree[u] += 1\n\nheap = [v for v in visited if in_degree[v] == 0]\nheapq.heapify(heap)\ntopo = []\nwhile heap:\n    c = heapq.heappop(heap)\n    topo.append(c)\n    for n in sorted(adj[c]):\n        in_degree[n] -= 1\n        if in_degree[n] == 0:\n            heapq.heap