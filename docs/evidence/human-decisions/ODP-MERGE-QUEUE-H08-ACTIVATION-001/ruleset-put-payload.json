{
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/dev"
      ]
    }
  },
  "enforcement": "active",
  "name": "dev-merge-queue",
  "rules": [
    {
      "parameters": {
        "check_response_timeout_minutes": 60,
        "grouping_strategy": "ALLGREEN",
        "max_entries_to_build": 5,
        "max_entries_to_merge": 5,
        "merge_method": "MERGE",
        "min_entries_to_merge": 2,
        "min_entries_to_merge_wait_minutes": 10
      },
      "type": "merge_queue"
    }
  ],
  "target": "branch"
}
