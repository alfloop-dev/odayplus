{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DurableJobPartialRetryContractDraft",
  "description": "Draft schema and behavioral contract for durable batch jobs supporting JobStatus.PARTIAL, itemized receipts, and member-level idempotency/retry.",
  "version": "1.1.0-draft.2026-09-08",
  "metadata": {
    "task_id": "ODP-DURABLE-PARTIAL-CONTRACT-PREP-001",
    "work_package": "WP-33A",
    "target_implementation_stage": "WP-33B",
    "inspected_commit_sha": "b6b729d95e575dc3b27ea9e02ce22fb128c3970b",
    "created_at": "2026-09-08T16:48:00Z"
  },
  "core_principles": {
    "status_orthogonality": {
      "business_outcome": "JobStatus: QUEUED | RUNNING | SUCCEEDED | FAILED | CANCELLED | PARTIAL",
      "delivery_mechanics": "JobDeliveryState: RETRYING | DEAD_LETTER | null",
      "rule": "JobStatus represents business outcome; JobDeliveryState represents queue delivery mechanics. In the existing system, normal success writes SUCCEEDED with delivery_state=null, active retries write QUEUED with delivery_state=RETRYING, and terminal failures write FAILED paired with delivery_state=DEAD_LETTER upon retry exhaustion or non-retryable errors. For multi-item batch jobs completing as PARTIAL, transport delivery is finished, so delivery_state is cleared (set to null), cleanly separating business partial completion from infrastructure dead-lettering without allowing transport delivery states to overwrite business outcome."
    },
    "state_transition_rules": {
      "single_item_jobs": "Must transition strictly to SUCCEEDED or FAILED (never PARTIAL).",
      "batch_multi_item_precedence_rules": [
        "1. Empty batch precedence: If total_count == 0 => JobStatus.SUCCEEDED (with succeeded_count = 0, failed_count = 0, cancelled_count = 0, pending_count = 0).",
        "2. Non-finalization rule: If pending_count > 0 => Job remains in active non-terminal state (JobStatus.RUNNING or JobStatus.QUEUED); pending items MUST NOT finalize the job into a terminal state.",
        "3. Cancellation precedence: If cancelled_count > 0 or job was aborted by operator/system => JobStatus.CANCELLED (takes unambiguous precedence over partial counts).",
        "4. All Succeeded: If succeeded_count == total_count and total_count > 0 and failed_count == 0 and cancelled_count == 0 and pending_count == 0 => JobStatus.SUCCEEDED.",
        "5. All Failed: If failed_count == total_count and total_count > 0 and succeeded_count == 0 and cancelled_count == 0 and pending_count == 0 => JobStatus.FAILED.",
        "6. Mixed Partial Outcome: If succeeded_count > 0 and failed_count > 0 and cancelled_count == 0 and pending_count == 0 => JobStatus.PARTIAL."
      ]
    },
    "scoped_retry_policy": {
      "default_scope": "FAILED_ONLY",
      "execution_behavior": "Engine reads previous ItemReceipt items; items with item_status == 'SUCCEEDED' are skipped with zero downstream invocations; items with item_status == 'FAILED' and error.retryable == false are permanent bad input and skipped with zero downstream invocations (attempt count unchanged); only items with item_status == 'FAILED' and error.retryable == true are re-executed (attempt incremented by 1).",
      "convergence_rule": "Retried items that succeed update item_status to SUCCEEDED and increment attempt. When all originally failed items reach SUCCEEDED, the aggregate JobStatus converges from PARTIAL to SUCCEEDED. If non-retryable failed items remain, the aggregate JobStatus remains PARTIAL with updated summary counts."
    }
  },
  "definitions": {
    "ItemError": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "Machine-readable error code (e.g. MISSING_MANDATORY_ADDRESS, GEOCODING_UPSTREAM_TIMEOUT, CANCELLED_BEFORE_EXECUTION)"
        },
        "message": {
          "type": "string",
          "description": "Human-readable explanation of failure"
        },
        "retryable": {
          "type": "boolean",
          "description": "True if transient failure eligible for retry; false if permanent bad input or deterministic rejection"
        },
        "details": {
          "type": "object",
          "description": "Optional arbitrary diagnostic payload",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "ItemReceipt": {
      "type": "object",
      "required": [
        "item_id",
        "item_status",
        "attempt",
        "result_ref",
        "error"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "description": "Unique identifier of the item within the job (e.g. row-001, loc-42)"
        },
        "item_status": {
          "type": "string",
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "PENDING"
          ],
          "description": "Terminal or lifecycle outcome for this specific member"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "description": "Total execution attempts made for this item (0 for unstarted PENDING or pre-execution CANCELLED items; >=1 for items that executed at least once)"
        },
        "result_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Pointer to created resource or receipt (e.g. intake-991823); null for failed, cancelled, or pending items"
        },
        "error": {
          "oneOf": [
            {
              "$ref": "#/definitions/ItemError"
            },
            {
              "type": "null"
            }
          ]
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ],
          "description": "Per-item client idempotency key if supplied"
        },
        "last_attempt_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Timestamp of last execution attempt, or null if attempt == 0"
        }
      },
      "additionalProperties": false
    },
    "JobSummary": {
      "type": "object",
      "required": [
        "total_count",
        "succeeded_count",
        "failed_count",
        "cancelled_count",
        "pending_count"
      ],
      "properties": {
        "total_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Sum of succeeded_count + failed_count + cancelled_count + pending_count"
        },
        "succeeded_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_count": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled_count": {
          "type": "integer",
          "minimum": 0
        },
        "pending_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "DurableJobReceipt": {
      "type": "object",
      "required": [
        "job_id",
        "job_type",
        "tenant_id",
        "status",
        "delivery_state",
        "summary",
        "items",
        "created_at",
        "completed_at"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "Global unique identifier of the durable job"
        },
        "job_type": {
          "type": "string",
          "description": "Registered job type in JobRegistry"
        },
        "tenant_id": {
          "type": "string",
          "description": "Authenticated tenant scope"
        },
        "correlation_id": {
          "type": "string",
          "description": "Distributed tracing correlation ID"
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ],
          "description": "Job-level idempotency key"
        },
        "status": {
          "type": "string",
          "enum": [
            "QUEUED",
            "RUNNING",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "PARTIAL"
          ]
        },
        "delivery_state": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "RETRYING",
            "DEAD_LETTER",
            null
          ]
        },
        "summary": {
          "$ref": "#/definitions/JobSummary"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ItemReceipt"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
