{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DurableJobPartialRetryContractDraft",
  "description": "Draft schema and behavioral contract for durable batch jobs supporting JobStatus.PARTIAL, itemized receipts, and member-level idempotency/retry.",
  "version": "1.0.0-draft.2026-09-08",
  "metadata": {
    "task_id": "ODP-DURABLE-PARTIAL-CONTRACT-PREP-001",
    "work_package": "WP-33A",
    "target_implementation_stage": "WP-33B",
    "inspected_commit_sha": "9048161e058becff5a53593a773d3c42238213fb",
    "created_at": "2026-09-08T16:12:00Z"
  },
  "core_principles": {
    "status_orthogonality": {
      "business_outcome": "JobStatus: QUEUED | RUNNING | SUCCEEDED | FAILED | CANCELLED | PARTIAL",
      "delivery_mechanics": "JobDeliveryState: RETRYING | DEAD_LETTER | null",
      "rule": "Terminal business states (SUCCEEDED, FAILED, PARTIAL, CANCELLED) MUST have delivery_state = null. Transport retry states (RETRYING, DEAD_LETTER) apply only during active queue delivery and MUST NOT overwrite business outcome."
    },
    "state_transition_rules": {
      "single_item_jobs": "Must transition strictly to SUCCEEDED or FAILED (never PARTIAL).",
      "batch_multi_item_jobs": [
        "If succeeded_count == total_count and failed_count == 0 => JobStatus.SUCCEEDED",
        "If succeeded_count == 0 and failed_count == total_count => JobStatus.FAILED",
        "If succeeded_count > 0 and failed_count > 0 => JobStatus.PARTIAL",
        "If job is aborted mid-batch by operator or system => JobStatus.CANCELLED",
        "If total_count == 0 (empty batch) => JobStatus.SUCCEEDED with summary counts = 0"
      ]
    },
    "scoped_retry_policy": {
      "default_scope": "FAILED_ONLY",
      "execution_behavior": "Engine reads previous ItemReceipt items; items with item_status == 'SUCCEEDED' are skipped with zero downstream invocations; only items with item_status == 'FAILED' and error.retryable == true are re-executed.",
      "convergence_rule": "Retried items that succeed update item_status to SUCCEEDED. When all items reach SUCCEEDED, the aggregate JobStatus converges from PARTIAL to SUCCEEDED."
    }
  },
  "definitions": {
    "ItemError": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "Machine-readable error code (e.g. MISSING_MANDATORY_ADDRESS, TIMEOUT_DOWNSTREAM)"
        },
        "message": {
          "type": "string",
          "description": "Human-readable explanation of failure"
        },
        "retryable": {
          "type": "boolean",
          "description": "True if transient failure eligible for retry; false if permanent bad input"
        },
        "details": {
          "type": "object",
          "description": "Optional arbitrary diagnostic payload",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "ItemReceipt": {
      "type": "object",
      "required": [
        "item_id",
        "item_status",
        "attempt",
        "result_ref",
        "error"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "description": "Unique identifier of the item within the job (e.g. row-001, loc-42)"
        },
        "item_status": {
          "type": "string",
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "PENDING"
          ],
          "description": "Terminal outcome for this specific member"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "description": "Total execution attempts made for this item"
        },
        "result_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Pointer to created resource or receipt (e.g. intake-991823)"
        },
        "error": {
          "oneOf": [
            {
              "$ref": "#/definitions/ItemError"
            },
            {
              "type": "null"
            }
          ]
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ],
          "description": "Per-item client idempotency key if supplied"
        },
        "last_attempt_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "JobSummary": {
      "type": "object",
      "required": [
        "total_count",
        "succeeded_count",
        "failed_count",
        "cancelled_count"
      ],
      "properties": {
        "total_count": {
          "type": "integer",
          "minimum": 0
        },
        "succeeded_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_count": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled_count": {
          "type": "integer",
          "minimum": 0
        },
        "pending_count": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "DurableJobReceipt": {
      "type": "object",
      "required": [
        "job_id",
        "job_type",
        "tenant_id",
        "status",
        "delivery_state",
        "summary",
        "items",
        "created_at",
        "completed_at"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "Global unique identifier of the durable job"
        },
        "job_type": {
          "type": "string",
          "description": "Registered job type in JobRegistry"
        },
        "tenant_id": {
          "type": "string",
          "description": "Authenticated tenant scope"
        },
        "correlation_id": {
          "type": "string",
          "description": "Distributed tracing correlation ID"
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ],
          "description": "Job-level idempotency key"
        },
        "status": {
          "type": "string",
          "enum": [
            "QUEUED",
            "RUNNING",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "PARTIAL"
          ]
        },
        "delivery_state": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "RETRYING",
            "DEAD_LETTER",
            null
          ]
        },
        "summary": {
          "$ref": "#/definitions/JobSummary"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ItemReceipt"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
