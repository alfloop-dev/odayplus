  "api_contract_specifications": {
    "query_job_endpoint": {
      "method": "GET",
      "path": "/platform/jobs/{job_id}",
      "response_status": 200,
      "response_body": {
        "job_id": "string",
        "job_type": "string",
        "status": "JobStatus",
        "delivery_state": "JobDeliveryState | null",
        "summary": "JobSummary"
      }
    },
    "receipt_job_endpoint": {
      "method": "GET",
      "path": "/api/v1/jobs/{job_id}/receipt",
      "response_status": 200,
      "response_body": "DurableJobReceipt"
    },
    "retry_job_endpoint": {
      "method": "POST",
      "path": "/platform/jobs/{job_id}/retry",
      "request_body": {
        "retry_scope": {
          "type": "string",
          "enum": [
            "FAILED_ONLY",
            "FAILED_RETRYABLE_ONLY"
          ],
          "default": "FAILED_ONLY"
        }
      },
      "response_status": 202,
      "response_body": {
        "job_id": "string",
        "status": "QUEUED",
        "retry_scope": "string",
        "retried_items_count": "integer"
      }
    }
  }
