#!/usr/bin/env bash
set -euo pipefail

resolve_user_home() {
  if [[ -n "${PANTHEON_CLAUDE_EXTENSION_HOME:-}" ]]; then
    printf '%s\n' "${PANTHEON_CLAUDE_EXTENSION_HOME}"
    return
  fi
  if command -v getent >/dev/null 2>&1; then
    local passwd_home
    passwd_home="$(getent passwd "$(id -un)" | cut -d: -f6 || true)"
    if [[ -n "${passwd_home}" ]]; then
      printf '%s\n' "${passwd_home}"
      return
    fi
  fi
  printf '%s\n' "${HOME}"
}

user_home="$(resolve_user_home)"

# Resolve the newest installed Claude Code extension binary.
#
# See .orchestrator/bin/gh for why this must not be written as
# `cli="$(ls -d ... 2>/dev/null | sort -V | tail -n1)"`. This wrapper is the live
# worker launcher for the Claude lane (config.json providers.claude.cli), so the
# silent-exit form is the worst instance of that bug: the day the extension path
# stops matching, every Claude worker would die with exit 2 and no output, the
# orchestrator would read it as a generic `terminal` failure instead of
# `provider_unavailable`, and it would keep dispatching into the dead lane
# instead of pausing it.
shopt -s nullglob
candidates=("${user_home}"/.vscode-server/extensions/anthropic.claude-code-*/resources/native-binary/claude)
shopt -u nullglob

cli=""
if (( ${#candidates[@]} )); then
  cli="$(printf '%s\n' "${candidates[@]}" | sort -V | tail -n1)"
fi

if [[ -z "${cli}" || ! -x "${cli}" ]]; then
  echo "Claude CLI binary not found under ~/.vscode-server/extensions." >&2
  exit 1
fi

exec "${cli}" "$@"
