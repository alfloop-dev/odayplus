                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              },
              "enable_auto_mode_if_supported": {
                "type": "boolean"
              },
              "include_hook_events": {
                "type": "boolean"
              },
              "home": {
                "type": "string"
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^\\S(?:.*\\S)?$"
                },
                "additionalProperties": {
                  "type": [
                    "boolean",
                    "number",
                    "string",
                    "null"
                  ]
                }
              },
              "mcp_config": {
                "type": "string"
              },
              "model": {
                "type": "string"
