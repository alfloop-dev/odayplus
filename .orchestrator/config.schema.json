              "dangerously_bypass": {
                "type": "boolean"
              },
              "dangerously_skip_permissions": {
                "type": "boolean"
              },
              "default_approval_mode": {
                "type": "string"
              },
              "enable_permanent_tool_approval": {
                "type": "boolean"
              },
              "auto_add_to_policy_by_default": {
                "type": "boolean"
              },
              "disable_yolo_mode": {
                "type": "boolean"
              },
              "disable_always_allow": {
                "type": "boolean"
              },
              "workspace_agent_yolo_mode": {
                "type": "boolean"
              },
              "disable_bypass_permissions": {
                "type": "boolean"
              },
              "orchestrator_only": {
                "type": "boolean"
              },
              "rule_default_mode": {
