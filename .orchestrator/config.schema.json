          "additionalProperties": false
        },
        "max_active_workers_per_task": {
          "type": "integer"
        },
        "max_dispatches_per_tick": {
          "type": "integer"
        },
        "owned_statuses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_statuses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewer_failover": {
