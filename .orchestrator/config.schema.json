        "watch_handoffs": {
          "type": "boolean"
        },
        "watch_reviewer_changes": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "github_bus": {
      "type": "object",
      "properties": {
        "archive_housekeeping_auto_merge": {
          "type": "boolean"
        },
        "close_resolved_issues": {
          "type": "boolean"
