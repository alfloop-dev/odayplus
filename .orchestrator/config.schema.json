        "command_timeout_seconds": {
          "type": "integer"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default_branch": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "pattern": "^\\S(?:.*\\S)?$"
