                  "high_risk_model": {
                    "type": "string"
                  },
                  "high_risk_priorities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "high_risk_keywords": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
