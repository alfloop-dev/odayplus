          "file_inbox": {
            "type": "object",
            "properties": {
              "open_in_vscode": {
                "type": "boolean"
              },
              "agent_paths": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^\\S(?:.*\\S)?$"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "path": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "quota_group": {
            "type": "string"
          },
          "runtime": {
            "type": "object",
            "properties": {
              "auto_permission_mode": {
                "type": "string"
              },
              "cli": {
                "type": "string"
              },
              "effort": {
                "type": "string",
