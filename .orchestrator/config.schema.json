              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "approvals": {
      "type": "object",
      "properties": {
        "stale_pending_seconds": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
