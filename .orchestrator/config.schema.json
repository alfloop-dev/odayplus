              },
              "http_port": {
                "type": "integer"
              },
              "persist_allow_by_default": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "codex": {
            "type": "object",
            "properties": {
              "ask_for_approval": {
